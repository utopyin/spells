{
  "name": "spells",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3",
      "zod": "4.3.6",
      "typescript": "6.0.2",
      "vite": "8.0.14",
      "alchemy": "2.0.0-beta.44",
      "effect": "4.0.0-beta.70",
      "@effect/platform-node": "4.0.0-beta.70",
      "@effect/platform-bun": "4.0.0-beta.70"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "deploy:web": "turbo run deploy --filter=web",
